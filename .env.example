# Backend (EC2). Sin estas variables la app corre en local con SQLite y archivos en uploads/.
PORT=3000
DB_DRIVER=mssql
DB_HOST=ecoraee-db.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_NAME=EcoRAEE
DB_ENCRYPT=true
# Usuario y clave de RDS: se leen de Secrets Manager con el rol de la instancia
DB_SECRET_ID=ecoraee/rds
AWS_REGION=us-east-1
S3_BUCKET_EVIDENCIAS=ecoraee-evidencias-xxxx
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:ecoraee-movimientos
CORS_ORIGIN=http://ecoraee-web-xxxx.s3-website-us-east-1.amazonaws.com

# Frontend (se usa al compilar con Vite para S3)
VITE_API_URL=http://ec2-0-0-0-0.compute-1.amazonaws.com:3000
